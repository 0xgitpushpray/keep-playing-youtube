{
  "manifest_version": 3,
  "name": "Keep Playing for YouTube",
  "version": "1.0.0",
  "description": "Stops YouTube and YouTube Music from pausing with \"Are you still there?\" / \"Video paused. Continue watching?\" prompts.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Keep Playing for YouTube",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*", "https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.youtube.com/*", "https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["src/keepalive.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
